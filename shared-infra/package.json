{
  "name": "@chief-strategist-j/shared-infra",
  "version": "1.0.1",
  "description": "Core engine: httpClient, adapters, decorators, event bus, rules engine, feature flags, centralized OpenTelemetry & messaging tracing",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./http": {
      "types": "./dist/http/http-client.d.ts",
      "import": "./dist/http/http-client.js",
      "require": "./dist/http/http-client.cjs"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js",
      "require": "./dist/store/index.cjs"
    },
    "./data-driven": {
      "types": "./dist/data-driven/index.d.ts",
      "import": "./dist/data-driven/index.js",
      "require": "./dist/data-driven/index.cjs"
    },
    "./event-bus": {
      "types": "./dist/event-bus/index.d.ts",
      "import": "./dist/event-bus/index.js",
      "require": "./dist/event-bus/index.cjs"
    },
    "./rules-engine": {
      "types": "./dist/rules-engine/index.d.ts",
      "import": "./dist/rules-engine/index.js",
      "require": "./dist/rules-engine/index.cjs"
    },
    "./feature-flags": {
      "types": "./dist/feature-flags/resolve-flag.d.ts",
      "import": "./dist/feature-flags/resolve-flag.js",
      "require": "./dist/feature-flags/resolve-flag.cjs"
    },
    "./messaging": {
      "types": "./dist/messaging/index.d.ts",
      "import": "./dist/messaging/index.js",
      "require": "./dist/messaging/index.cjs"
    },
    "./kafka": {
      "types": "./dist/messaging/index.d.ts",
      "import": "./dist/messaging/index.js",
      "require": "./dist/messaging/index.cjs"
    },
    "./tracing": {
      "types": "./dist/tracing/index.d.ts",
      "import": "./dist/tracing/index.js",
      "require": "./dist/tracing/index.cjs"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js",
      "require": "./dist/discovery/index.cjs"
    },
    "./json-map": {
      "types": "./dist/json-map/index.d.ts",
      "import": "./dist/json-map/index.js",
      "require": "./dist/json-map/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "publish:github": "./scripts/deployment/publish.sh",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@reduxjs/toolkit": "^2.6.0",
    "redux-saga": "^1.3.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-redux": ">=9"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "react": "^19.0.0",
    "react-redux": "^9.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^2.1.8"
  }
}
