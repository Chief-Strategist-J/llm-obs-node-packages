{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@observability/shared-infra": ["../shared-infra/src/index.ts"],
      "@observability/shared-infra/http": ["../shared-infra/src/http/index.ts"],
      "@observability/shared-infra/discovery": ["../shared-infra/src/discovery/index.ts"],
      "@observability/shared-infra/feature-flags": ["../shared-infra/src/feature-flags/resolve-flag.ts"],
      "@observability/shared-infra/rules-engine": ["../shared-infra/src/rules-engine/index.ts"],
      "@observability/shared-infra/json-map": ["../shared-infra/src/data-driven/json-map.ts"],
      "@observability/shared-infra/*": ["../shared-infra/src/*"],
      "@observability/auth": ["../auth/src/index.ts"],
      "@observability/auth/*": ["../auth/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
